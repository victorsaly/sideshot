{
  "name": "sideshot",
  "private": true,
  "type": "module",
  "description": "Development scripts for SideShot. The skill itself needs nothing installed but Playwright in the project it runs in.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='skills/**/lib.mjs' --test-coverage-lines=90 --test-coverage-branches=80 'test/*.test.mjs'",
    "test:e2e": "node --test 'test/e2e/*.e2e.mjs'"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
