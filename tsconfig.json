{
  // Type checks the JavaScript as it is: no build, nothing emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    // Said, not left to the default, which TypeScript 7 changed to strict: the check means the same whatever
    // version runs it. Stricter checking is a change of its own.
    "strict": false
  },
  "include": ["skills/**/*.mjs", "test/**/*.mjs", "eslint.config.mjs"]
}
