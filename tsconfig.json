{
  // Type checks the JavaScript as it is: no build, nothing emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["skills/**/*.mjs", "test/**/*.mjs", "eslint.config.mjs"]
}
